+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct MenuRect {
+    pub x: i16,
+    pub y: i16,
+    pub width: u16,
+    pub height: u16,
+}
+
+pub fn allocate_context(
+    output: &OutputState,
+    workspaces: &[WorkspaceState],
+    menu: &[(MenuItemId, String, bool)],
+) -> (Vec<WorkspaceRect>, Vec<MenuRect>) {
+    let workspace_width = (workspaces.len() as u32 * 72).min(output.width as u32) as u16;
+    let workspace_output = OutputState {
+        width: workspace_width,
+        ..output.clone()
+    };
+    let workspaces = allocate(&workspace_output, workspaces);
+    let mut x = output.x.saturating_add(workspace_width as i16);
+    let end = output.x.saturating_add(output.width as i16);
+    let mut rects = Vec::new();
+    for (_, label, _) in menu {
+        let width = (label.chars().count() as u16)
+            .saturating_mul(8)
+            .saturating_add(20)
+            .max(20);
+        if x.saturating_add(width as i16) > end {
+            break;
+        }
+        rects.push(MenuRect {
+            x,
+            y: output.y,
+            width,
+            height: 26,
+        });
+        x = x.saturating_add(width as i16);
+    }
+    (workspaces, rects)
